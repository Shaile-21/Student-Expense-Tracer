# Student Expense Tracker - Global Environment Configuration Reference

# Backend Port
PORT=5000

# Environment Mode (development | production | test)
NODE_ENV=development

# MongoDB Connection String
# Connects to local MongoDB, MongoDB Atlas, or automatically falls back to local persistent JSON DB
MONGODB_URI=mongodb://127.0.0.1:27017/student_expense_tracker

# JWT Authentication Secret & Token Expiry
JWT_SECRET=super_secret_jwt_key_student_expense_tracker_2024
JWT_EXPIRE=30d

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173
